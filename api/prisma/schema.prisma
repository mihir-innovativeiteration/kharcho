datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String               @id @default(uuid())
  name               String
  email              String               @unique
  emailVerifiedAt    DateTime?
  passwordHash       String?
  preferredLanguage  String               @default("en")
  preferredTheme     String               @default("light")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  disabledAt         DateTime?

  authIdentities     AuthIdentity[]
  refreshSessions    RefreshSession[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  transactions       Transaction[]
  categories         Category[]
  paymentMethods     PaymentMethod[]
  budgets            Budget[]
  savingsGoals       SavingsGoal[]
  savingsContributions SavingsContribution[]
  budgetAlerts       BudgetAlert[]
  budgetAlertsEnabled Boolean            @default(true)
  billRemindersEnabled Boolean           @default(true)
  savingsMilestonesEnabled Boolean       @default(true)
  syncAlertsEnabled    Boolean           @default(true)
  dailySummaryEnabled  Boolean           @default(false)
  recurringRules     RecurringRule[]
  recurringOccurrences RecurringOccurrence[]
  recurringReminders RecurringReminder[]
  syncReceipts       SyncReceipt[]
  devicePushTokens   DevicePushToken[]

  @@index([email])
}

model AuthIdentity {
  id              String   @id @default(uuid())
  userId          String
  provider        String   // "google"
  providerSubject String   // Google sub
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  deviceInfo String?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model VerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  type            TransactionType
  amount          Decimal         @db.Decimal(19, 4)
  currency        String          @default("INR")
  description     String          @db.VarChar(255)
  categoryId      String
  paymentMethodId String?
  transactionDate DateTime
  notes           String?         @db.Text
  clientMutationId String?        @unique
  version         Int             @default(1)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  recurringOccurrence RecurringOccurrence?

  @@index([userId])
  @@index([userId, transactionDate])
  @@index([userId, type])
  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@index([categoryId])
  @@index([paymentMethodId])
}

model Category {
  id        String          @id @default(uuid())
  userId    String?
  name      String          @db.VarChar(100)
  type      TransactionType
  icon      String          @db.VarChar(50)
  color     String?         @db.VarChar(20)
  isSystem  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurringRules RecurringRule[]

  @@index([userId])
  @@index([type])
  @@index([isSystem])
}

model PaymentMethod {
  id        String        @id @default(uuid())
  userId    String?
  name      String        @db.VarChar(100)
  type      String        @db.VarChar(50)
  details   String?       @db.VarChar(100)
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringRules RecurringRule[]

  @@index([userId])
  @@index([isSystem])
}


model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum BudgetType {
  OVERALL
  CATEGORY
}

enum BudgetPeriod {
  MONTHLY
  CUSTOM
}

model Budget {
  id                String       @id @default(uuid())
  userId            String
  name              String       @db.VarChar(100)
  type              BudgetType   @default(CATEGORY)
  categoryId        String?
  amount            Decimal      @db.Decimal(19, 4)
  currency          String       @default("INR")
  period            BudgetPeriod @default(MONTHLY)
  startDate         DateTime?
  endDate           DateTime?
  warningThresholds String       @default("50,80,100") // comma-separated percentage list
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  alerts   BudgetAlert[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([categoryId])
}

model BudgetAlert {
  id               String   @id @default(uuid())
  userId           String
  budgetId         String
  thresholdPercent Int
  periodKey        String   @db.VarChar(50) // e.g. "2026-10"
  triggeredAt      DateTime @default(now())
  readAt           DateTime?
  createdAt        DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, thresholdPercent, periodKey])
  @@index([userId])
  @@index([userId, readAt])
}

enum SavingsGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model SavingsGoal {
  id           String            @id @default(uuid())
  userId       String
  name         String            @db.VarChar(100)
  description  String?           @db.VarChar(255)
  targetAmount Decimal           @db.Decimal(19, 4)
  currency     String            @default("INR")
  targetDate   DateTime?
  icon         String?           @db.VarChar(50)
  color        String?           @db.VarChar(20)
  status       SavingsGoalStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([userId])
  @@index([userId, status])
}

model SavingsContribution {
  id               String      @id @default(uuid())
  userId           String
  goalId           String
  amount           Decimal     @db.Decimal(19, 4)
  contributionDate DateTime    @default(now())
  note             String?     @db.VarChar(255)
  createdAt        DateTime    @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([goalId])
  @@index([goalId, contributionDate])
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum OccurrenceStatus {
  UPCOMING
  DUE
  AWAITING_CONFIRMATION
  PAID
  SKIPPED
  FAILED
}

model RecurringRule {
  id                 String              @id @default(uuid())
  userId             String
  title              String              @db.VarChar(150)
  description        String?             @db.VarChar(255)
  providerName       String?             @db.VarChar(100)
  type               TransactionType     @default(EXPENSE)
  amount             Decimal             @db.Decimal(19, 4)
  currency           String              @default("INR")
  categoryId         String?
  paymentMethodId    String?
  frequency          RecurringFrequency  @default(MONTHLY)
  interval           Int                 @default(1)
  startDate          DateTime
  nextDueAt          DateTime
  endDate            DateTime?
  timezone           String              @default("Asia/Kolkata")
  reminderEnabled    Boolean             @default(true)
  reminderDaysBefore Int                 @default(1)
  autoPost           Boolean             @default(false)
  status             RecurringStatus     @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethod      PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  occurrences        RecurringOccurrence[]
  reminders          RecurringReminder[]

  @@index([userId])
  @@index([userId, status])
  @@index([status, nextDueAt])
  @@index([categoryId])
}

model RecurringOccurrence {
  id              String               @id @default(uuid())
  recurringRuleId String
  userId          String
  occurrenceKey   String               @db.VarChar(100)
  scheduledAt     DateTime
  status          OccurrenceStatus     @default(UPCOMING)
  transactionId   String?              @unique
  reminderSentAt  DateTime?
  paidAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  rule            RecurringRule        @relation(fields: [recurringRuleId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction     Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  reminders       RecurringReminder[]

  @@unique([recurringRuleId, occurrenceKey])
  @@index([userId])
  @@index([userId, scheduledAt])
  @@index([userId, status])
  @@index([recurringRuleId, scheduledAt])
}

model RecurringReminder {
  id             String               @id @default(uuid())
  userId         String
  ruleId         String
  occurrenceId   String
  title          String               @db.VarChar(150)
  message        String               @db.VarChar(255)
  amount         Decimal              @db.Decimal(19, 4)
  currency       String               @default("INR")
  dueDate        DateTime
  isRead         Boolean              @default(false)
  readAt         DateTime?
  createdAt      DateTime             @default(now())

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule           RecurringRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  occurrence     RecurringOccurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@unique([userId, occurrenceId])
  @@index([userId])
  @@index([userId, isRead])
}

model SyncReceipt {
  id            String   @id @default(uuid())
  userId        String
  operationId   String   @unique
  entityType    String   @db.VarChar(50)
  entityId      String   @db.VarChar(100)
  operationType String   @db.VarChar(20) // CREATE, UPDATE, DELETE
  status        String   @db.VarChar(20) // APPLIED, CONFLICT, FAILED
  resultPayload String?  @db.Text
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([operationId])
  @@index([userId, entityType, entityId])
}

model DevicePushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(255)
  platform  String   @db.VarChar(20) // "ios", "android", "web"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}


