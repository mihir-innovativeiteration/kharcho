NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://root:password@localhost:3306/kharcho_db
ACCESS_TOKEN_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long_for_security_12345
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=mock-google-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=mock-google-ios-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=mock-google-web-client-id.apps.googleusercontent.com
CORS_ORIGINS=http://localhost:8081,http://10.0.2.2:8081
EMAIL_PROVIDER=console
EMAIL_FROM=Kharcho <no-reply@kharcho.app>
PASSWORD_RESET_BASE_URL=kharcho://reset-password
EMAIL_VERIFICATION_BASE_URL=kharcho://verify-email
